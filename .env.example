# Instagram プロアカウント (ビジネス/クリエイター) の ID
IG_USER_ID=17841400000000000
# instagram_content_publish 権限付きの長期アクセストークン
IG_ACCESS_TOKEN=
# Facebook ログインのトークン: graph.facebook.com / Instagram ログインのトークン: graph.instagram.com
GRAPH_HOST=graph.facebook.com
GRAPH_API_VERSION=v23.0

# ---- 楽天ブログ メール投稿 (python -m rakuten_blog) ----
# 楽天ブログ管理画面で確認できる「投稿用メールアドレス」
RAKUTEN_POST_ADDRESS=
# 送信に使う SMTP (Gmail の場合は 2 段階認証 + アプリパスワード)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# 送信元 (楽天ブログ側で登録した送信元アドレスと一致させる。省略時は SMTP_USER)
SMTP_FROM=

# ---- 楽天アフィリエイト (記事に商品リンクを自動挿入) ----
# 楽天アフィリエイトのアフィリエイトID (未設定ならリンクも【PR】表記も入りません)
RAKUTEN_AFFILIATE_ID=
# 楽天ウェブサービスのアプリID (任意: あれば商品検索APIで実際の商品・価格を表示。無ければ検索結果ページへのリンク)
RAKUTEN_APP_ID=
# 楽天ウェブサービスでアクセスキーが発行されている場合のみ
RAKUTEN_ACCESS_KEY=
